{
  "name": "footygen-web",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "images:build": "node scripts/images/build.cjs",
    "test:images": "node scripts/images/images.test.cjs && node scripts/images/preload.test.cjs",
    "predev": "npm run images:build",
    "prebuild": "npm run images:build && npm run seo:assets",
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:account": "node scripts/account/account.test.cjs",
    "backend:setup": "node scripts/backend/build-setup.cjs",
    "backend:check": "node scripts/backend/check.cjs",
    "backend:publish": "node scripts/backend/publish-snapshot.cjs",
    "test:backend": "node scripts/backend/database.test.cjs && node scripts/backend/games.test.cjs && node scripts/backend/auth.test.cjs",
    "test:scoreline": "node scripts/scoreline/scoreline.test.cjs && node scripts/scoreline/api.test.cjs",
    "test:higher-lower": "node scripts/higher-lower/higher-lower.test.cjs",
    "test:matrix": "node scripts/matrix/matrix.test.cjs",
    "test:journeyman": "node scripts/journeyman/journeyman.test.cjs",
    "test:scouts-duel": "node scripts/scouts-duel/scouts-duel.test.cjs && node scripts/scouts-duel/feedback.test.cjs",
    "test:scouts-duel:api": "node scripts/scouts-duel/api-smoke.cjs",
    "validate:scouts-duel": "node scripts/scouts-duel/validate-data.cjs",
    "build:journeyman": "node scripts/journeyman/import-dataset.cjs",
    "validate:journeyman": "node scripts/journeyman/import-dataset.cjs --check",
    "seo:assets": "node scripts/seo/build-assets.cjs",
    "test:site": "node scripts/site/site.test.cjs",
    "test:decoy": "node scripts/decoy/decoy.test.cjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
